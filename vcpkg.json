{
  "name": "webkit",
  "dependencies": [
    "icu"
  ],
  "features": {
    "avif": {
      "description": "Build with AVIF image support",
      "dependencies": [
        {
          "name": "libavif",
          "features": [
            "aom"
          ]
        }
      ]
    },
    "cairo": {
      "description": "Build with cairo graphics backend",
      "dependencies": [
        "cairo"
      ]
    },
    "gstreamer": {
      "description": "Build with the GStreamer media backend (MSE, D3D11 hardware decoding, FFmpeg software fallback)",
      "dependencies": [
        {
          "name": "gstreamer",
          "default-features": false,
          "features": [
            "gl",
            "plugins-base",
            "plugins-good",
            "plugins-bad",
            "libav"
          ]
        },
        {
          "name": "ffmpeg",
          "default-features": false,
          "features": [
            "avcodec",
            "avfilter",
            "avformat",
            "dav1d",
            "swresample"
          ]
        },
        "glib",
        "pkgconf"
      ]
    },
    "jpeg-xl": {
      "description": "Build with JPEG XL image support",
      "dependencies": [
        "libjxl"
      ]
    },
    "lcms": {
      "description": "Build with Little-CMS support",
      "dependencies": [
        "lcms"
      ]
    },
    "skia": {
      "description": "Build with skia graphics backend",
      "dependencies": [
        "expat",
        {
          "name": "harfbuzz",
          "default-features": false,
          "features": [
            "directwrite",
            "icu"
          ]
        }
      ]
    },
    "web": {
      "description": "Build the web browser",
      "dependencies": [
        "brotli",
        {
          "name": "curl",
          "features": [
            "http3",
            "ipv6",
            "libressl"
          ]
        },
        "libjpeg-turbo",
        "libpng",
        "libpsl",
        "libressl",
        "libwebp",
        {
          "name": "libxml2",
          "default-features": false,
          "features": [
            "icu"
          ]
        },
        "libxslt",
        "nghttp2",
        "nghttp3",
        {
          "name": "ngtcp2",
          "features": [
            "openssl"
          ]
        },
        {
          "name": "sqlite3",
          "features": [
            "fts3",
            "json1",
            "rtree"
          ]
        },
        "zlib"
      ]
    },
    "woff2": {
      "description": "Build with WOFF2 file support",
      "dependencies": [
        "woff2"
      ]
    }
  },
  "overrides": [
    {
      "name": "ngtcp2",
      "version": "1.12.0"
    }
  ]
}
